<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wbg_grad_2" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@mipmap/ic_launcher" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="6dp">
                <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الصلاة القادمة" android:textColor="#E6D6F5" android:textSize="11dp" android:maxLines="1" android:ellipsize="end"  />
                <TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر  ٢:٤٣ م" android:textColor="#FFFFFF" android:textSize="18dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/w_cd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بعد ٢ س ١٥ د" android:textColor="#FFB066" android:textSize="14dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
                <TextView android:id="@+id/w_city" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الرياض" android:textColor="#E6D6F5" android:textSize="10dp" android:maxLines="1" android:ellipsize="end"  />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/w_hijri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٢ جمادى الآخرة ١٤٤٨ هـ" android:textColor="#E6D6F5" android:textSize="11dp" android:maxLines="1" android:ellipsize="end"  android:layout_marginTop="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/n0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textColor="#FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
                <TextView android:id="@+id/t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٤:٥٢ ص" android:textColor="#FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end"  />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الظهر" android:textColor="#FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
                <TextView android:id="@+id/t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="١١:٣٩ ص" android:textColor="#FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end"  />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="#FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
                <TextView android:id="@+id/t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٢:٤٣ م" android:textColor="#FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end"  />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المغرب" android:textColor="#FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
                <TextView android:id="@+id/t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٥:٠٤ م" android:textColor="#FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end"  />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العشاء" android:textColor="#FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
                <TextView android:id="@+id/t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٦:٣٤ م" android:textColor="#FFFFFF" android:textSize="12dp" android:maxLines="1" android:ellipsize="end"  />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
