<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wbg_grad_2" android:contentDescription="@null" />
    <ImageView android:id="@+id/wscrim" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wbg_dark_2" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/p_art" android:layout_width="58dp" android:layout_height="58dp" android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:id="@+id/p_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مشغّل ذَكِّرني" android:textColor="#FFFFFF" android:textSize="17dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
                <TextView android:id="@+id/p_artist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اضغط لاختيار الملفات" android:textColor="#E6D6F5" android:textSize="12.5dp" android:maxLines="1" android:ellipsize="end"  />
                <TextView android:id="@+id/p_sleep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFB066" android:textSize="11dp" android:maxLines="1" android:ellipsize="end"  android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
        <ProgressBar android:id="@+id/p_prog" style="@android:style/Widget.Material.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp" android:max="1000" android:progress="0" android:progressTint="#FFB066" android:progressBackgroundTint="#55FFFFFF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:layoutDirection="ltr">
            <ImageView android:id="@+id/p_shuf" android:layout_width="38dp" android:layout_height="38dp" android:padding="8dp" android:src="@drawable/ic_p_shuffle" android:contentDescription="p_shuf" />
            <ImageView android:id="@+id/p_prev" android:layout_width="44dp" android:layout_height="44dp" android:padding="6dp" android:src="@drawable/ic_p_prev" android:contentDescription="p_prev" />
            <ImageView android:id="@+id/p_toggle" android:layout_width="58dp" android:layout_height="58dp" android:padding="8dp" android:src="@drawable/ic_p_play" android:contentDescription="p_toggle" />
            <ImageView android:id="@+id/p_next" android:layout_width="44dp" android:layout_height="44dp" android:padding="6dp" android:src="@drawable/ic_p_next" android:contentDescription="p_next" />
            <ImageView android:id="@+id/p_rep" android:layout_width="38dp" android:layout_height="38dp" android:padding="8dp" android:src="@drawable/ic_p_repeat" android:contentDescription="p_rep" />
            <ImageView android:id="@+id/p_timer" android:layout_width="38dp" android:layout_height="38dp" android:padding="8dp" android:src="@drawable/ic_p_timer" android:contentDescription="p_timer" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
