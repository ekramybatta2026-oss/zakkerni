<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ph_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp">
    <ImageView android:id="@+id/ph_img" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null" android:visibility="gone" />
    <ImageView android:id="@+id/ph_edit" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:padding="6dp" android:src="@drawable/ic_ph_edit" android:background="@drawable/ph_btn" android:contentDescription="تغيير الصور" android:visibility="gone" />
    <LinearLayout android:id="@+id/ph_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/wbg_dark_2">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_zakkerni" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="اضغط لإضافة صورك" android:textColor="#FFB066" android:textSize="13dp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
