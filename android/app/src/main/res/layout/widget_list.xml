<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wbg_grad_2" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="12dp">
        <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الصلاة القادمة" android:textColor="#E6D6F5" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"  />
        <TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر  ٢:٤٣ م" android:textColor="#FFFFFF" android:textSize="17sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        <TextView android:id="@+id/w_cd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بعد ٢ س ١٥ د" android:textColor="#FFB066" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        <TextView android:id="@+id/w_hijri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#E6D6F5" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end"  />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/n0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الفجر" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٤:٥٢ ص" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/n1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الظهر" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="١١:٣٩ ص" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/n2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="العصر" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٢:٤٣ م" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/n3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="المغرب" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٥:٠٤ م" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/n4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="العشاء" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="٦:٣٤ م" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
        </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/w_city" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الرياض" android:textColor="#E6D6F5" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"  />
    </LinearLayout>
</FrameLayout>
