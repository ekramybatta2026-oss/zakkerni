<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl" android:paddingStart="3.5dp" android:paddingEnd="3.5dp" android:paddingTop="4.5dp" android:paddingBottom="12.5dp">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToOutline="true" android:scaleType="fitXY" android:src="@drawable/wbg_auto_2" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="8dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layoutDirection="ltr">
            <TextClock android:id="@+id/k_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="#FFFFFF" android:textSize="40dp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" />
            <TextView android:id="@+id/k_ampm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_marginBottom="4dp" android:text="ص" android:textColor="#FFB066" android:textSize="14dp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/k_wx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="ltr">
            <TextView android:id="@+id/k_wicon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="18dp" />
            <TextView android:id="@+id/k_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="27°" android:textColor="#FFFFFF" android:textSize="18dp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/k_hl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#FFB066" android:textSize="11dp" android:maxLines="1" />
            <TextView android:id="@+id/k_wdesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/k_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="الأحد 22 نوفمبر" android:textColor="#FFFFFF" android:textSize="12.5dp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/k_hijri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 جمادى الآخرة" android:textColor="#FFB066" android:textSize="11.5dp" android:maxLines="1" />
        <TextView android:id="@+id/k_greg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
