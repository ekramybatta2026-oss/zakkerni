<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl" android:paddingStart="3.5dp" android:paddingEnd="3.5dp" android:paddingTop="4.5dp" android:paddingBottom="12.5dp">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToOutline="true" android:scaleType="fitXY" android:src="@drawable/wbg_grad_2" android:contentDescription="@null" />
    <ImageView android:id="@+id/wscrim" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wbg_dark_2" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp">
        <ImageView android:id="@+id/p_art" android:layout_width="54dp" android:layout_height="54dp" android:scaleType="centerCrop" android:src="@mipmap/ic_zakkerni" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/p_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مشغّل ذَكِّرني" android:textColor="#FFFFFF" android:textSize="15dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
            <TextView android:id="@+id/p_artist" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اضغط لاختيار الملفات" android:textColor="#E6D6F5" android:textSize="12dp" android:maxLines="1" android:ellipsize="end"  />
            <TextView android:id="@+id/p_sleep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFB066" android:textSize="11dp" android:maxLines="1" android:ellipsize="end"  android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="ltr">
            <ImageView android:id="@+id/p_prev" android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp" android:src="@drawable/ic_p_prev" android:contentDescription="p_prev" />
            <ImageView android:id="@+id/p_toggle" android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/ic_p_play" android:contentDescription="p_toggle" />
            <ImageView android:id="@+id/p_next" android:layout_width="40dp" android:layout_height="40dp" android:padding="6dp" android:src="@drawable/ic_p_next" android:contentDescription="p_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
