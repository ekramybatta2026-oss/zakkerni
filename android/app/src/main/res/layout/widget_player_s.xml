<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
    <FrameLayout android:id="@+id/p_box" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="top|center_horizontal">
        <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToOutline="true" android:scaleType="fitXY" android:src="@drawable/wbg_grad_2" android:contentDescription="@null" />
        <ImageView android:id="@+id/wscrim" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wbg_dark_2" android:contentDescription="@null" />
        <ImageView android:id="@+id/p_art" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:contentDescription="@null" />
        <ImageView android:id="@+id/p_prev" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:contentDescription="@null" />
        <ImageView android:id="@+id/p_next" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:contentDescription="@null" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="6dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/p_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مشغّل ذَكِّرني" android:textColor="#FFFFFF" android:textSize="13dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/p_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E6D6F5" android:textSize="10.5dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/p_sleep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFB066" android:textSize="10dp" android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <ImageView android:id="@+id/p_toggle" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:padding="6dp" android:src="@drawable/ic_p_play" android:scaleType="fitCenter" android:contentDescription="p_toggle" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
