<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wbg_grad_2" android:contentDescription="@null" />
    <ImageView android:id="@+id/wscrim" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/wbg_dark_2" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="12dp">
        <ImageView android:id="@+id/p_art" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:contentDescription="@null" />
        <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layoutDirection="ltr">
            <ImageView android:id="@+id/p_prev" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:padding="7dp" android:src="@drawable/ic_p_prev" android:scaleType="fitCenter" android:contentDescription="p_prev" />
            <ImageView android:id="@+id/p_toggle" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1.3" android:padding="6dp" android:src="@drawable/ic_p_play" android:scaleType="fitCenter" android:contentDescription="p_toggle" />
            <ImageView android:id="@+id/p_next" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:padding="7dp" android:src="@drawable/ic_p_next" android:scaleType="fitCenter" android:contentDescription="p_next" />
        </LinearLayout>
        <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/p_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مشغّل ذَكِّرني" android:textColor="#FFFFFF" android:textSize="14dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:gravity="center"/>
        <TextView android:id="@+id/p_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="" android:textColor="#E6D6F5" android:textSize="11dp" android:maxLines="1" android:ellipsize="end" android:gravity="center"/>
        <TextView android:id="@+id/p_sleep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFB066" android:textSize="11dp" android:maxLines="1" android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>
