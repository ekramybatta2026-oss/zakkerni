<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/n_root" android:layout_width="match_parent" android:layout_height="96dp" android:layoutDirection="rtl">
    <ImageView android:id="@+id/n_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="17dp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/n_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#E6D6F5" android:textSize="13dp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="ltr">
            <ImageView android:id="@+id/n_prev" android:layout_width="42dp" android:layout_height="42dp" android:padding="9dp" android:src="@drawable/ic_p_prev" android:contentDescription="السابق" />
            <ImageView android:id="@+id/n_toggle" android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:padding="9dp" android:src="@drawable/ic_p_play" android:contentDescription="تشغيل" />
            <ImageView android:id="@+id/n_next" android:layout_width="42dp" android:layout_height="42dp" android:padding="9dp" android:src="@drawable/ic_p_next" android:contentDescription="التالي" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
