<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl">
    <ImageView android:id="@+id/wbg" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToOutline="true" android:scaleType="fitXY" android:src="@drawable/wbg_auto_2" android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="10dp">
        <TextView android:id="@+id/c_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المؤقت" android:textColor="#E6D6F5" android:textSize="12dp"  android:maxLines="1" />
        <Chronometer android:id="@+id/c_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="30dp" android:textStyle="bold" android:layoutDirection="ltr" />
        <TextView android:id="@+id/c_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFB066" android:textSize="11dp"  android:maxLines="1" android:visibility="gone"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center" android:layoutDirection="ltr">
            <ImageView android:id="@+id/c_b1" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:padding="7dp" android:background="@drawable/w_btn" android:src="@drawable/ic_c_reset" android:scaleType="fitCenter" android:contentDescription="c_b1" /><ImageView android:id="@+id/c_b2" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:padding="9dp" android:background="@drawable/w_btn" android:src="@drawable/ic_p_play" android:scaleType="fitCenter" android:contentDescription="c_b2" /><ImageView android:id="@+id/c_b3" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:padding="7dp" android:background="@drawable/w_btn" android:src="@drawable/ic_c_plus" android:scaleType="fitCenter" android:contentDescription="c_b3" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
